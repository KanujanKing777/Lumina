rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Isolated User Journal & Interaction Vault
    match /users/{userId}/interactions/{interactionId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Isolated User Notification Settings & Preferences
    match /users/{userId}/notificationSettings/{settingId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Isolated User Notification Audit & Delivery Logs
    match /users/{userId}/notificationLogs/{logId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Isolated User Folders & Collections
    match /users/{userId}/folders/{folderId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Isolated User Writing Goals & Habits
    match /users/{userId}/goals/{goalId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Isolated User Future Me Messages (Time-Capsule / Scheduled Reflections)
    match /users/{userId}/futureMe/{futureMeId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.userId == userId
                    && request.resource.data.scheduledFor is number
                    && request.resource.data.createdAt is number
                    && request.resource.data.scheduledFor >= request.resource.data.createdAt;
      allow update: if request.auth != null && request.auth.uid == userId;
    }
  }
}
