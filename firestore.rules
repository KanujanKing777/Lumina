rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Isolated User Journal & Interaction Vault
    match /users/{userId}/interactions/{interactionId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Isolated User Notification Settings & Preferences
    match /users/{userId}/notificationSettings/{settingId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Isolated User Notification Audit & Delivery Logs
    match /users/{userId}/notificationLogs/{logId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Isolated User Folders & Collections
    match /users/{userId}/folders/{folderId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Isolated User Writing Goals & Habits
    match /users/{userId}/goals/{goalId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
