{
  "entities": {
    "Interaction": {
      "title": "Interaction",
      "description": "User journal conversation and AI reflection session.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner UID" },
        "title": { "type": "string", "maxLength": 200, "description": "Journal title" },
        "mode": { "type": "string", "enum": ["reflect", "brainstorm", "summarize", "action_plan"], "description": "Reflection mode" },
        "initialPrompt": { "type": "string", "maxLength": 10000, "description": "First prompt" },
        "messages": { "type": "array", "description": "Array of messages" },
        "summary": { "type": "string", "maxLength": 1000, "description": "Summary" },
        "keyInsights": { "type": "array", "description": "List of key takeaways" },
        "tags": { "type": "array", "description": "Tags list" },
        "detectedEvents": { "type": "array", "description": "Extracted journal event types" },
        "createdAt": { "type": "number", "description": "Creation timestamp" },
        "updatedAt": { "type": "number", "description": "Last update timestamp" },
        "modelUsed": { "type": "string", "description": "Gemini model used" }
      },
      "required": ["userId", "title", "mode", "messages", "createdAt", "updatedAt"]
    },
    "NotificationSettings": {
      "title": "NotificationSettings",
      "description": "User notification configuration and preferences.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner UID" },
        "enabled": { "type": "boolean", "description": "Whether external notifications are enabled" },
        "emailDestination": { "type": "string", "maxLength": 254, "description": "Recipient email address" },
        "enabledEventTypes": { "type": "array", "description": "Configured event types that trigger notifications" },
        "providerType": { "type": "string", "enum": ["email", "webhook"], "description": "Notification delivery provider type" },
        "webhookUrl": { "type": "string", "maxLength": 2048, "description": "Optional webhook endpoint" },
        "includeSummary": { "type": "boolean", "description": "Whether to include high-level summary" },
        "updatedAt": { "type": "number", "description": "Last update timestamp" }
      },
      "required": ["userId", "enabled", "enabledEventTypes", "updatedAt"]
    },
    "NotificationLog": {
      "title": "NotificationLog",
      "description": "Audit and delivery status log of an external notification event.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner UID" },
        "interactionId": { "type": "string", "description": "Associated interaction ID" },
        "eventType": { "type": "string", "description": "Journal event type" },
        "provider": { "type": "string", "description": "Notification provider name" },
        "destination": { "type": "string", "description": "Masked destination" },
        "status": { "type": "string", "enum": ["pending", "sent", "failed", "retrying", "disabled"], "description": "Delivery status" },
        "idempotencyKey": { "type": "string", "description": "Unique key to prevent duplicate notifications" },
        "attempts": { "type": "number", "description": "Number of delivery attempts" },
        "timestamp": { "type": "number", "description": "Timestamp of notification event" },
        "summarySnippet": { "type": "string", "maxLength": 500, "description": "Minimized event message" },
        "errorMessage": { "type": "string", "description": "Error details if failed" }
      },
      "required": ["userId", "eventType", "provider", "status", "idempotencyKey", "timestamp"]
    },
    "Folder": {
      "title": "Folder",
      "description": "User journal collection or folder.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner UID" },
        "name": { "type": "string", "maxLength": 100, "description": "Folder name" },
        "color": { "type": "string", "description": "Optional color tag" },
        "createdAt": { "type": "number", "description": "Creation timestamp" },
        "updatedAt": { "type": "number", "description": "Update timestamp" }
      },
      "required": ["userId", "name", "createdAt"]
    },
    "FutureMeMessage": {
      "title": "FutureMeMessage",
      "description": "Scheduled time-capsule message to the user's future self with entry snapshot.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner UID" },
        "sourceEntryId": { "type": "string", "description": "Original journal entry ID if applicable" },
        "title": { "type": "string", "maxLength": 200, "description": "Message or entry title" },
        "message": { "type": "string", "maxLength": 5000, "description": "Optional note to future self" },
        "optionalFutureQuestion": { "type": "string", "maxLength": 1000, "description": "Optional question for future self" },
        "scheduledFor": { "type": "number", "description": "Delivery timestamp in ms" },
        "createdAt": { "type": "number", "description": "Creation timestamp in ms" },
        "updatedAt": { "type": "number", "description": "Last update timestamp" },
        "deliveredAt": { "type": "number", "description": "Timestamp when delivery became available" },
        "openedAt": { "type": "number", "description": "Timestamp when user unsealed the message" },
        "status": { "type": "string", "enum": ["scheduled", "delivered", "cancelled", "failed"], "description": "Delivery status" },
        "notificationEnabled": { "type": "boolean", "description": "Whether user requested a delivery notification" },
        "snapshot": { "type": "object", "description": "Preserved minimal journal entry snapshot" },
        "reflectionResult": { "type": "string", "description": "Gemini AI reflection on past vs present" },
        "reflectionModelUsed": { "type": "string", "description": "Model used for reflection" }
      },
      "required": ["userId", "title", "scheduledFor", "createdAt", "status", "snapshot"]
    }
  },
  "firestore": {
    "/users/{userId}/interactions/{interactionId}": {
      "schema": "Interaction",
      "description": "User journal entries and AI reflections."
    },
    "/users/{userId}/notificationSettings/{settingId}": {
      "schema": "NotificationSettings",
      "description": "User notification configuration and event preferences."
    },
    "/users/{userId}/notificationLogs/{logId}": {
      "schema": "NotificationLog",
      "description": "Delivery history and audit log for external notifications."
    },
    "/users/{userId}/folders/{folderId}": {
      "schema": "Folder",
      "description": "User folders and collections."
    },
    "/users/{userId}/futureMe/{futureMeId}": {
      "schema": "FutureMeMessage",
      "description": "Scheduled time-capsule messages to future self."
    }
  }
}
